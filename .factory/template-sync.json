{
  "templateRepo": "cesarchavezcal/grok-bot-agent-factory",
  "defaultRef": "main",
  "versionFile": ".factory/template-version",
  "managedPaths": [
    ".factory/template-sync.json",
    ".github/workflows/*",
    ".github/ISSUE_TEMPLATE/*",
    "scripts/*",
    ".agents/skills/*",
    ".cursor/rules",
    ".cursor/agents",
    "AGENTS.md",
    "skills-lock.json",
    ".factory/work-item.schema.json",
    ".factory/WORK-ITEM.example.json",
    ".factory/schemas/*",
    "models.allowed.yml"
  ],
  "preserveLocalPaths": [
    ".factory/config.json",
    ".factory/work-items",
    ".factory/memory",
    ".agents/skills/verify-app/features",
    "models.yml"
  ]
}
